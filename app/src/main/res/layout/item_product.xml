<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="7dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:strokeWidth="0dp"
    app:rippleColor="#1A000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Product Image Container with Warm Sand Background & Wishlist Heart -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/app_card">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <!-- Floating Out of Stock Badge -->
                <TextView
                    android:id="@+id/badge_out_of_stock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_badge_out_of_stock"
                    android:text="OUT OF STOCK"
                    android:textColor="#FFFFFF"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:visibility="gone" />


                <ImageView
                    android:id="@+id/product_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/p1" />

                <!-- Floating Top-Right Heart Outline Button matching Vellora Mockup -->
                <ImageView
                    android:id="@+id/btn_card_wishlist"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="6dp"
                    android:src="@drawable/ic_nav_heart_round"
                    app:tint="@color/text_primary" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Product Name and Price Row matching Vellora Mockup Screen -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="4dp"
            android:paddingBottom="4dp">

            <!-- Product Title (Left aligned) -->
            <TextView
                android:id="@+id/product_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/product_price"
                android:layout_centerVertical="true"
                android:layout_marginEnd="6dp"
                android:text="Warm Woolen Sweater"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Product Price (Right aligned) -->
            <TextView
                android:id="@+id/product_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Rs. 4,950"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Rating Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="4dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/product_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#x2605; 0.0"
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/product_reviews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(0)"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
